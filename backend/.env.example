# 3D Concept Visualizer - Example Environment Variables
# Copy this file to .env and fill in secrets as needed

# --- Environment Settings ---
ENVIRONMENT=development  # Environment: development, staging, production

# --- OpenAI Settings ---
OPENAI_API_KEY=          # Your OpenAI API key (required for OpenAI features)
OPENAI_MODEL=gpt-4-turbo-preview  # Default OpenAI model

# --- Google AI Settings ---
GOOGLE_API_KEY=          # Your Google API key (required for Gemini features)

# --- Vector Store Settings ---
VECTOR_STORE_DIMENSION=384  # Embedding dimension (default: all-MiniLM-L6-v2)
VECTOR_STORE_COLLECTION_NAME=visualizations  # Qdrant collection name

# --- Database Settings ---
DATABASE_URL=sqlite:///./app.db  # SQLAlchemy DB URL (override for Postgres)
DATABASE_ECHO=False              # SQLAlchemy echo SQL (True/False)
DATABASE_POOL_RECYCLE=1800       # SQLAlchemy pool recycle seconds

# --- Model Settings ---
OLLAMA_BASE_URL=http://localhost:11434  # Ollama server URL
OLLAMA_MODEL=qwen2.5:32b                # Default Ollama model
GEMINI_MODEL=gemini-2.0-flash           # Default Gemini model

# --- Generation Settings ---
TEMPERATURE=0.7     # LLM temperature
STREAM=False        # Stream LLM responses (True/False)

# --- Similar Visualizations Limit ---
SIMILAR_VIS_LIMIT=10  # Max similar visualizations to return

# --- Validation System Configuration ---
ENABLE_COMPREHENSIVE_VALIDATION=True  # Enable all validation steps
ENABLE_RUNTIME_VALIDATION=True        # Enable JS runtime validation
VALIDATION_TIMEOUT_HTML=30            # HTML validation timeout (seconds)
VALIDATION_TIMEOUT_SCIENTIFIC=45      # Scientific validation timeout (seconds)
VALIDATION_TIMEOUT_REALISM=30         # Realism validation timeout (seconds)
VALIDATION_TIMEOUT_RUNTIME=60         # Runtime validation timeout (seconds)

# --- Quality Scoring Configuration ---
QUALITY_SCORE_THRESHOLD=5.5   # Minimum quality score
ENABLE_QUALITY_FILTERING=True # Filter by quality score
ENABLE_FEEDBACK_LOOP=True     # Enable feedback loop

# --- Context Filtering Configuration ---
CONTEXT_FILTER_MIN_QUALITY=5.5         # Min quality for context filter
CONTEXT_FILTER_MAX_ITEMS=5             # Max items for context filter
CONTEXT_FILTER_ENSURE_DIVERSITY=True   # Ensure diversity in context

# --- Error Fixing & Retry ---
MAX_LLM_RETRY=3                        # Max LLM retry attempts
ENABLE_ERROR_FIXING=True               # Enable error fixing
SAVE_ALL_VALIDATION_ERRORS=True        # Log all validation errors
ERROR_FIXING_TEMPLATE_PATH=error_fixing_template.prompt.txt  # Path to error fixing template
MAX_VALIDATION_ATTEMPTS=2              # Max validation attempts with error fixing

# --- Quality Enhancement ---
ENABLE_QUALITY_ENHANCEMENT=True            # Enable quality enhancement
ENABLE_POST_VALIDATION_ENHANCEMENT=True    # Post-validation enhancement
QUALITY_ENHANCEMENT_MAX_ATTEMPTS=2         # Max enhancement attempts
QUALITY_ENHANCEMENT_MIN_IMPROVEMENT=0.5    # Min improvement for enhancement
QUALITY_ENHANCEMENT_SKIP_THRESHOLD=6.0     # Skip if score above this

# --- Keycloak Configuration ---
KEYCLOAK_SERVER_URL=http://localhost:28080     # Keycloak server URL
KEYCLOAK_REALM=local-apps                      # Keycloak realm
KEYCLOAK_CLIENT_ID=3d-visualization-app        # Keycloak client ID
KEYCLOAK_CLIENT_SECRET=                        # Keycloak client secret (required for confidential clients)
KEYCLOAK_ADMIN_USERNAME=admin                  # Keycloak admin username
KEYCLOAK_ADMIN_PASSWORD=admin123               # Keycloak admin password

# --- JWT Configuration ---
JWT_ALGORITHM=RS256    # JWT signing algorithm
JWT_AUDIENCE=account   # JWT audience

# --- Authentication ---
AUTH_ENABLED=True              # Enable authentication
AUTH_BYPASS_DEVELOPMENT=True   # Bypass auth in development

# --- 3D Model Storage ---
MODEL_STORAGE_BASE_DIR=../models         # Base dir for 3D models
MODEL_API_BASE_URL=http://localhost:8000 # Base URL for model API

# MODEL_CATEGORIES and MODEL_SUBJECTS are set in code; override only if customizing
# MODEL_CATEGORIES=electronics,biology,chemistry,physics,mathematics,geography,astronomy,engineering,architecture,art
# MODEL_SUBJECTS=physics,chemistry,biology,mathematics,geography,astronomy,engineering,computer_science,art,history

ENABLE_MODEL_SEARCH=True                 # Enable model search
MODEL_SEARCH_SIMILARITY_THRESHOLD=0.5    # Similarity threshold for model search

# --- Gold Standards Analysis Prompt ---
# GOLD_STANDARD_ANALYSIS_PROMPT and ENHANCEMENT_PROMPT are multi-line and set in code; override only if customizing
# GOLD_STANDARD_ANALYSIS_PROMPT=\"\"\"\n...\n\"\"\"
# ENHANCEMENT_PROMPT=\"\"\"\n...\n\"\"\"
