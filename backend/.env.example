# --- Environment Settings ---
ENVIRONMENT=development

# --- Database ---
# By default uses SQLite. For Postgres, use: postgresql://user:pass@localhost:5432/dbname
DATABASE_URL=sqlite:///./app.db
DATABASE_ECHO=false
DATABASE_POOL_RECYCLE=1800

# --- OpenAI API ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# --- Google Generative AI ---
GOOGLE_API_KEY=your-google-api-key

# --- Ollama Model API ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b

# --- Gemini Model ---
GEMINI_MODEL=gemini-2.0-flash

# --- Vector Store ---
VECTOR_STORE_DIMENSION=384  # Dimension for all-MiniLM-L6-v2 model
VECTOR_STORE_COLLECTION_NAME=visualizations

# --- Qdrant/RAG (optional, for production-scale vector search) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=visualizations
SIMILAR_VIS_LIMIT=10  # Context search similarity results count

# --- LLM Settings ---
TEMPERATURE=0.7
STREAM=false
