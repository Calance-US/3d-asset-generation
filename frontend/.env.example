# Frontend Environment Variables Template
# Copy this file to .env.local and configure for your environment

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=development

# Keycloak Authentication Configuration
REACT_APP_KEYCLOAK_SERVER_URL=http://localhost:28080
REACT_APP_KEYCLOAK_REALM=local-apps
REACT_APP_KEYCLOAK_CLIENT_ID=3d-visualization-app

# Optional: Additional Keycloak Configuration
# REACT_APP_KEYCLOAK_PUBLIC_CLIENT=true
# REACT_APP_KEYCLOAK_CHECK_LOGIN_IFRAME=false
# REACT_APP_KEYCLOAK_SILENT_CHECK_SSO_REDIRECT_URI=http://localhost:3000/silent-check-sso.html

# Development Configuration
REACT_APP_DEBUG_MODE=true
REACT_APP_LOG_LEVEL=debug

# Feature Flags
REACT_APP_ENABLE_AUTH=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_ERROR_REPORTING=false

# Production Configuration (for production builds)
# REACT_APP_API_BASE_URL=https://your-api-domain.com
# REACT_APP_KEYCLOAK_SERVER_URL=https://your-keycloak-domain.com
# REACT_APP_ENVIRONMENT=production
# REACT_APP_DEBUG_MODE=false
# REACT_APP_LOG_LEVEL=error

# Optional: Custom Styling
# REACT_APP_THEME=dark
# REACT_APP_PRIMARY_COLOR=#3B82F6
# REACT_APP_SECONDARY_COLOR=#8B5CF6

# Optional: External Services
# REACT_APP_ANALYTICS_ID=your-analytics-id
# REACT_APP_ERROR_REPORTING_DSN=your-error-reporting-dsn

# Browser Support
GENERATE_SOURCEMAP=true
ESLINT_NO_DEV_ERRORS=true
TSC_COMPILE_ON_ERROR=true
